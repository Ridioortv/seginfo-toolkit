# --- General ---
# 'development' desactiva los chequeos que fallan cerrado (secretos de ejemplo, SIEM_INGEST_TOKEN
# ausente, claves de agente de ejemplo). El launcher crea .env con 'production'; si copias este
# archivo a mano, cambialo a 'production' despues de poner secretos propios (tools\rotar-secretos.ps1).
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinelops
POSTGRES_HOST=postgres
# Puerto de Postgres DENTRO de la red de Docker (los servicios lo usan asi). No se publica en la PC,
# por eso no choca con un PostgreSQL que ya tengas instalado.
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Contrasena de Redis. El launcher y tools\rotar-secretos.ps1 la generan solos; si copias
# este archivo a mano, pone una larga y aleatoria (nada de 'changeme').
REDIS_PASSWORD=changeme-redis
# Contrasena del usuario admin de OpenSearch (SIEM). Tiene que ser FUERTE: mayuscula,
# minuscula, numero y simbolo, minimo 12 caracteres; si no, OpenSearch no arranca.
OPENSEARCH_ADMIN_PASSWORD=Changeme-0penSearch!

# --- Auth service ---
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Login/registro con Google (opcional). Sacar el Client ID desde
# https://console.cloud.google.com/apis/credentials -> Crear
# credenciales -> ID de cliente de OAuth -> Aplicacion web, con
# http://localhost:5173 en 'Origenes de JavaScript autorizados'.
# Mismo valor en las dos variables (el Client ID de Google es
# publico, lo usa el frontend para el boton y el backend para
# validar el token). Si se deja vacio, el boton de Google no
# aparece y el login sigue funcionando con email/password.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER_NAME=TERO Security

# --- Suscripcion / licencia (ver backend/shared/license_check.py y
# licensing-server/) ---
# Todas estas quedan VACIAS por defecto: sin LICENSE_SERVER_URL,
# auth-service solo usa el vencimiento local (Organization.subscription_expires_at,
# gestionado a mano via POST /auth/organizations/{id}/subscription/extend).
# Completalas SOLO en una instalacion que vaya a validar contra el
# servidor central de licencias del operador.
#
# LICENSE_SERVER_URL: URL publica del servidor central (ver licensing-server/README.md).
# LICENSE_KEY: la license_key que el operador te dio para ESTA instalacion.
# LICENSE_SERVER_PUBLIC_KEY: clave publica Ed25519 (base64) del servidor
#   central -- la imprime licensing-server/generate_keys.py. Es publica
#   por diseño (solo permite VERIFICAR, nunca fabricar, una respuesta).
LICENSE_SERVER_URL=
LICENSE_KEY=
LICENSE_SERVER_PUBLIC_KEY=B88iF4/B5QWJ+BwVfobj2xcfGBB85Tkt2M4nBh90Ajg=
# Cada cuantas horas auth-service vuelve a confirmar la licencia contra
# el servidor central (solo aplica si LICENSE_SERVER_URL esta seteado).
LICENSE_CHECK_INTERVAL_HOURS=6
# Pasarelas de pago que se ofrecen en "Pagos y licencia" y en el login bloqueado:
# "paypal", "mercadopago" o las dos separadas por coma. Con una sola, el boton
# "Generar link de pago" va directo a esa. Vacio = las dos.
PAYMENT_PROVIDERS=paypal,mercadopago

# Alta abierta de cuentas (pantalla de registro / Google sin alta previa). "true" = cualquiera puede
# crear una cuenta, pero SIEMPRE entra como "Solo lectura" (nunca elige su rol). "false" = solo
# entran cuentas creadas por un administrador (recomendado en un cliente). El primer usuario
# de la instalacion siempre puede registrarse y queda como administrador.
ALLOW_SELF_REGISTRATION=true

# --- Seguridad (CORS y cifrado de secretos en reposo) ---
# CORS_ALLOWED_ORIGINS: lista separada por comas de origenes exactos que
# pueden llamar a la API desde el navegador (ver backend/shared/cors.py),
# ej. "http://localhost:5173,https://sentinelops.tuempresa.com". Si se
# deja vacio, se usa FRONTEND_URL (o http://localhost:5173) -- alcanza
# para el uso normal en una sola maquina. Solo hace falta setearlo si el
# frontend se sirve desde otro dominio/puerto.
CORS_ALLOWED_ORIGINS=

# ENCRYPTION_KEY: clave usada para cifrar en reposo el client_secret de
# SSO (auth-service) y las credenciales de los conectores de
# contencion/ticketing (integration-service) -- ver
# backend/shared/crypto.py. El launcher (Iniciar.exe) genera un valor
# random propio para esta instalacion la primera vez que crea .env; no
# hace falta tocar esto a mano, y NO copiar el valor de otra instalacion.
ENCRYPTION_KEY=changeme-generate-a-long-random-secret

# --- Asset / Scan / Vuln services ---
# Zona horaria en la que corren los "Escaneos programados" (ver
# app/main.py::_SCHEDULER_TZ). Sin esto, las reglas se registran en UTC
# -- una regla creada como "16:14" corre a las 16:14 UTC (13:14 en
# Argentina), no a las 16:14 hora local. Poner la zona real del operador,
# ej. America/Argentina/Buenos_Aires (cubre toda Argentina, sin DST).
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires
EPSS_API_URL=https://api.first.org/data/v1/epss
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8001
VITE_ASSET_API_BASE_URL=http://localhost:8002
VITE_SCAN_API_BASE_URL=http://localhost:8003
VITE_VULN_API_BASE_URL=http://localhost:8004
VITE_SIEM_API_BASE_URL=http://localhost:8005
VITE_SOAR_API_BASE_URL=http://localhost:8006
VITE_CASE_API_BASE_URL=http://localhost:8007
VITE_PURPLE_API_BASE_URL=http://localhost:8008
VITE_REPORT_API_BASE_URL=http://localhost:8009
VITE_NOTIFICATION_API_BASE_URL=http://localhost:8010
VITE_INTEGRATION_API_BASE_URL=http://localhost:8011
VITE_THREATINTEL_API_BASE_URL=http://localhost:8012
VITE_ASM_API_BASE_URL=http://localhost:8013
VITE_CLOUD_API_BASE_URL=http://localhost:8014
VITE_CODEREPO_API_BASE_URL=http://localhost:8015

# --- SOAR / Integration / Notification (modo dry-run por defecto) ---
SOAR_DRY_RUN=true
INTEGRATION_DRY_RUN=true
NOTIFICATION_DRY_RUN=true

# SMTP (opcional). Lo usan: (1) el canal de notificaciones 'email' y (2) el mail de
# "Olvide mi contrasena" (el link vale 30 min y se usa una sola vez). El link apunta a
# FRONTEND_URL (por defecto http://localhost:5173): si TERO se abre desde otra direccion,
# descomentar y poner esa direccion. Sin SMTP, "Olvide mi contrasena" no manda mail: un
# administrador genera el link desde Usuarios y roles > "Restablecer contrasena".
# FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinelops@tuempresa.com

# --- Threat Intel (threatintel-service) ---
# API key de AbuseIPDB (https://www.abuseipdb.com/account/api) -- free
# tier: 1000 consultas/dia. Si se deja vacia, threatintel-service NUNCA
# llama a la API (evita gastar cupo) y devuelve "no se pudo chequear"
# para toda IP publica.
ABUSEIPDB_API_KEY=
# MISP (opcional, mejor esfuerzo) -- si cualquiera de las dos queda
# vacia, esa fuente se omite en silencio.
MISP_URL=
MISP_API_KEY=

# --- ASM service (monitoreo de superficie externa) ---
# Cada cuantas horas corre el chequeo automatico de todos los dominios
# monitoreados habilitados (descubrimiento via crt.sh + chequeo TLS).
ASM_CHECK_INTERVAL_HOURS=12

# --- Cloud service (inventario/hallazgos de una cuenta de AWS, solo lectura) ---
# Reutiliza ENCRYPTION_KEY (ya definida arriba, ver backend/shared/crypto.py)
# para cifrar en reposo access_key_id/secret_access_key de cada cuenta de
# AWS conectada -- no hace falta una clave nueva.
#
# Cada cuantas horas corre el sync automatico de todas las cuentas de AWS
# habilitadas (inventario EC2/S3 + deteccion de buckets publicos y security
# groups abiertos a 0.0.0.0/0).
CLOUD_SYNC_INTERVAL_HOURS=6

# Las credenciales de AWS se configuran via la API/UI (POST /accounts),
# NUNCA por env vars. Referencia: el usuario/rol IAM que hay que crear en
# la cuenta de AWS del cliente necesita EXACTAMENTE esta politica de solo
# lectura (nada de Create*/Modify*/Delete*/Put*):
#
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Sid": "SentinelOpsCloudServiceReadOnly",
#       "Effect": "Allow",
#       "Action": [
#         "ec2:DescribeInstances",
#         "ec2:DescribeSecurityGroups",
#         "s3:ListAllMyBuckets",
#         "s3:GetBucketAcl",
#         "s3:GetBucketPolicyStatus",
#         "s3:GetPublicAccessBlock",
#         "s3:GetBucketLocation"
#       ],
#       "Resource": "*"
#     }
#   ]
# }

# --- Coderepo service (secretos en git + dependencias vulnerables) ---
# Cada cuanto coderepo-service clona y vuelve a escanear (gitleaks +
# trivy fs) todos los repositorios habilitados. Default 24hs -- clonar +
# escanear un repo completo (todo el historial de git) es mas pesado que
# un chequeo de dominio/cuenta AWS.
CODEREPO_SCAN_INTERVAL_HOURS=24

# --- Confianza y evidencia (case-service) ---
# Semilla de la clave Ed25519 con la que se firma la cadena de custodia. Si no la
# definis, se deriva de JWT_SECRET_KEY: funciona, pero queda atada a ese secreto.
# Recomendado: un texto largo y secreto, guardado aparte, definido ANTES de empezar a
# usar la cadena (cambiarla despues invalida las firmas anteriores).
# CUSTODY_SIGNING_SEED=
# Para apagar el envio de eventos de custodia desde un servicio (por ejemplo en pruebas).
# TERO_CUSTODY_DISABLED=1

# --- Gobernanza de IA en el codigo (coderepo-service) ---
# Clave con la que se firma el registro auditable (HMAC). Si no la definis, se
# deriva de JWT_SECRET_KEY: funciona, pero rotar JWT_SECRET_KEY invalidaria las
# firmas anteriores. Recomendado: una clave propia y larga, guardada aparte.
# AUDIT_LEDGER_KEY=
# Tope de commits nuevos que se leen por escaneo de cada repositorio (default 300).
# CODEREPO_GOV_MAX_COMMITS=300
# Reutiliza ENCRYPTION_KEY (ya definida arriba) para cifrar el token de
# GitHub de los repositorios privados registrados.

# --- Agentes de escaneo remoto que se auto-registran y arrancan solos ---
# scan-service crea estos agentes al arrancar (idempotente). Genera keys
# propias, por ejemplo con:  python -c "import secrets;print(secrets.token_urlsafe(32))"
REMOTE_AGENT_DOCKER_KEY=cambiame-key-agente-docker
REMOTE_AGENT_LAN_KEY=cambiame-key-agente-lan
REMOTE_AGENT_WAN_KEY=cambiame-key-agente-wan
BOOTSTRAP_AGENTS=[{"name":"Agente Docker (internet/host)","key":"cambiame-key-agente-docker"},{"name":"Agente LAN","key":"cambiame-key-agente-lan"},{"name":"Agente WAN (internet)","key":"cambiame-key-agente-wan"}]
# Cualquier agente "bootstrap" que ya NO figure en BOOTSTRAP_AGENTS se borra
# solo al arrancar scan-service (junto con sus escaneos remotos).

# --- Reglas propias para semgrep/yara (y home de ZAP) en los agentes ---
# El Agente Docker (remote-agent corriendo en docker-compose.yml) ya trae
# estas 3 variables seteadas con las reglas que se copian dentro de la
# imagen -- no hace falta tocar nada para ese agente. Son para el caso
# donde se corre remote-agent/agent.py o remote-agent/agente-lan.ps1 a
# mano, FUERA de Docker (tipicamente el Agente LAN en una PC de la
# oficina/cliente), y se quiere usar un set de reglas distinto al que
# viene por default (relativo a la carpeta del repo).
# SENTINELOPS_SEMGREP_RULES_DIR=/ruta/a/tus/reglas/semgrep
# SENTINELOPS_YARA_RULES_FILE=/ruta/a/tus/reglas/yara/sentinelops.yar
# SENTINELOPS_ZAP_HOME_DIR=/ruta/a/un/home/de/ZAP (perfil de ZAP; si no se
#   especifica, ZAP usa el default de la maquina del agente)

# --- Exposicion de puertos (seguridad) ---
# Interfaz donde docker-compose publica las APIs y el frontend. Default
# 127.0.0.1 = solo accesible desde esta PC. Para usarlo desde otra maquina de la
# LAN (o agentes en VMs) pone 0.0.0.0 -- SOLO detras de un firewall o un reverse
# proxy con TLS. Postgres, Redis y OpenSearch quedan siempre en 127.0.0.1.
# BIND_ADDR=127.0.0.1
# Genera TODOS los secretos con:  powershell -File tools\rotar-secretos.ps1

# Token MAESTRO para POST /logs/ingest del SIEM: solo para los servicios internos
# (scan/asm/cloud). Un forwarder externo de un cliente usa su token POR ORGANIZACION
# (el admin lo obtiene en GET /logs/ingest-token del siem-service): solo vale para su org.
# Generar uno largo y aleatorio.
SIEM_INGEST_TOKEN=changeme-ingest-token

# Solo si la instalacion es de UNA empresa y su proveedor SSO (Keycloak/ADFS) o su GitLab/Gitea
# viven en una IP privada de la LAN: por defecto se bloquean (SSRF).
# OIDC_ALLOW_PRIVATE_NETWORK=true
# CODEREPO_ALLOW_PRIVATE_NETWORK=true

# --- Construccion de imagenes (solo si se compila en la PC) ---------------------
# Compila a lo sumo 3 imagenes a la vez: con las 17 en paralelo una PC chica se queda
# sin RAM/disco. Compose lee esta variable desde este archivo.
COMPOSE_PARALLEL_LIMIT=3
# Para apagar las "attestations" (SBOM/provenance) de BuildKit hay que exportar
# BUILDX_NO_DEFAULT_ATTESTATIONS=1 en la terminal (los scripts de Linux Mint y el
# Makefile ya lo hacen): agregan capas extra y tiempo a cada build sin servir a una PC local.
