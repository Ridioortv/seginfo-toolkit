# Agente OpenVAS -- configuracion (ver README.md para los pasos completos)
# cp .env.example .env   y completa los valores de abajo.

# URL del scan-service del stack PRINCIPAL de SentinelOps (la PC/servidor
# donde esta instalado todo lo demas), alcanzable desde ESTA maquina --
# por IP de LAN/VPN si estan en redes distintas, por ejemplo:
#   SCAN_SERVICE_URL=http://192.168.1.50:8003
SCAN_SERVICE_URL=http://CAMBIAR-ESTA-IP:8003

# Api key de este agente. Se genera UNA vez en la UI de SentinelOps:
# "Escaneos" -> "Agentes de escaneo remoto" -> "Registrar agente". Se
# muestra una sola vez al registrarlo -- copiala ahi (ver README.md paso 3).
AGENT_API_KEY=

# Completados automaticamente por ./configurar-gvm.sh (README.md paso 2)
# -- no hace falta tocarlos a mano.
GVM_USER=
GVM_PASSWORD=
