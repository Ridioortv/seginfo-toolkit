# PLANTILLA -- copiar a secret.yaml, completar con valores reales y NUNCA
# comitear ese archivo (ver infra/k8s/base/.gitignore). En produccion se
# recomienda usar un gestor externo (Sealed Secrets, External Secrets
# Operator + Vault/AWS Secrets Manager) en vez de un Secret plano.
apiVersion: v1
kind: Secret
metadata:
  name: sentinelops-secrets
  namespace: sentinelops
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CAMBIAR-generar-password-fuerte"
  JWT_SECRET_KEY: "CAMBIAR-generar-secreto-largo-y-aleatorio"
