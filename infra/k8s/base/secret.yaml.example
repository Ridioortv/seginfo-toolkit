# PLANTILLA -- copiar a secret.yaml, completar con valores reales y NUNCA
# comitear ese archivo (ver infra/k8s/base/.gitignore). En produccion se
# recomienda usar un gestor externo (Sealed Secrets, External Secrets
# Operator + Vault/AWS Secrets Manager) en vez de un Secret plano.
apiVersion: v1
kind: Secret
metadata:
  name: sentinelops-secrets
  namespace: sentinelops
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CAMBIAR-generar-password-fuerte"
  JWT_SECRET_KEY: "CAMBIAR-generar-secreto-largo-y-aleatorio"
  ENCRYPTION_KEY: "CAMBIAR-generar-clave-de-32-bytes-en-hex"
  # Redis y OpenSearch exigen contrasena (ver docker-compose.yml). OpenSearch pide
  # una contrasena fuerte: mayuscula, minuscula, numero y simbolo.
  REDIS_PASSWORD: "CAMBIAR-generar-password-fuerte"
  OPENSEARCH_ADMIN_PASSWORD: "CAMBIAR-Os!-con-mayuscula-minuscula-numero-y-simbolo-9X"
  # Token interno para POST /logs/ingest del SIEM (header X-Ingest-Token).
  SIEM_INGEST_TOKEN: "CAMBIAR-generar-token-largo-y-aleatorio"
