aws_region   = "us-east-1"
environment  = "dev"
project_name = "sentinelops"

# db_password: NO poner un valor real aca. Pasar con:
#   TF_VAR_db_password="$(openssl rand -base64 24)" terraform apply
# redis_auth_token y opensearch_master_password: tampoco aca. Pasar con
#   TF_VAR_redis_auth_token="$(openssl rand -hex 24)"
#   TF_VAR_opensearch_master_password="Os!$(openssl rand -hex 12)9X"
# eks_public_access_cidrs: limitar el API de EKS a tu IP/VPN, ej. ["203.0.113.10/32"]
