# Token que protege los endpoints /admin/* (crear, extender y revocar
# licencias). Genera uno largo y random, ej.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Nunca lo compartas -- con este token cualquiera puede emitir licencias.
ADMIN_TOKEN=changeme-generate-a-long-random-secret

# Clave privada Ed25519 con la que este servidor firma cada respuesta de
# /license/{license_key}/status. Generar con: python generate_keys.py
# (ese mismo comando imprime tambien la clave PUBLICA que va en cada
# instalacion on-prem, en LICENSE_SERVER_PUBLIC_KEY). NUNCA se distribuye
# a ningun cliente -- solo vive aca.
LICENSE_SIGNING_PRIVATE_KEY=changeme-run-generate-keys.py

# --- Almacenamiento: elegir UNO de los dos caminos --------------------
#
# CAMINO A -- VPS propio con Docker Compose (ver docker-compose.yml y
# Caddyfile): deja DATABASE_URL vacio. La base SQLite vive en el
# volumen local, persiste entre reinicios porque el VPS tiene disco
# propio. Tambien completa LICENSE_SERVER_DOMAIN (dominio real con un
# registro DNS A apuntando a la IP publica del VPS) para que Caddy le
# ponga TLS automatico (Let's Encrypt) -- sin esto, Caddy no puede
# pedir el certificado y ADMIN_TOKEN quedaria viajando en texto plano.
LICENSING_DB_PATH=/data/licensing.db
LICENSE_SERVER_DOMAIN=changeme.tu-dominio.com
#
# CAMINO B -- Render (gratis, sin tarjeta) + Neon/Supabase Postgres
# (gratis, sin tarjeta): el disco del plan free de Render es
# descartable (se borra en cada reinicio/redeploy), asi que la base
# tiene que vivir afuera del contenedor. Completa DATABASE_URL con la
# connection string que te da Neon/Supabase (ya incluye sslmode=require,
# pegala tal cual) -- si esta seteada, este servidor usa Postgres en
# vez de SQLite y LICENSING_DB_PATH se ignora. Render ya da TLS
# automatico en su propio dominio *.onrender.com, asi que en este
# camino no hace falta Caddy ni LICENSE_SERVER_DOMAIN.
DATABASE_URL=

# --- PayPal (cobro de los USD 250/30 dias a TU cuenta) ---
# Credenciales de tu app REST en https://developer.paypal.com/dashboard/applications
# (creá una app ahi -- te da Client ID y Secret, uno para "Sandbox" y
# otro para "Live"). Sin estas dos, /webhooks/paypal y
# /admin/clients/*/paypal-subscription-link devuelven 503.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" mientras probás (paga con las cuentas de prueba que da el
# dashboard de PayPal, sin plata real) -- cambiar a "live" recien
# cuando esto ya funciono end-to-end en sandbox.
PAYPAL_ENV=sandbox
# El id del webhook que registres en el dashboard (Apps -> tu app ->
# Add Webhook) apuntando a https://tu-servidor/webhooks/paypal, con al
# menos estos eventos tildados: BILLING.SUBSCRIPTION.ACTIVATED,
# PAYMENT.SALE.COMPLETED. El dashboard te muestra el Webhook ID despues
# de crearlo.
PAYPAL_WEBHOOK_ID=
# El id del Billing Plan de $250 cada 30 dias (Apps & Credentials ->
# Products & Plans, o via la API de Billing Plans/Subscriptions). Se
# crea UNA vez; despues cada cliente se suscribe a este mismo plan.
PAYPAL_PLAN_ID=
# A donde vuelve el navegador del cliente despues de aprobar/cancelar
# en PayPal -- poné la URL de tu propia pagina de "gracias" si tenés
# una; si no, deja el default (no rompe nada, solo es menos prolijo).
PAYPAL_RETURN_URL=https://www.google.com/?sentinelops_subscribed=1
PAYPAL_CANCEL_URL=https://www.google.com/?sentinelops_cancelled=1

# --- Mercado Pago (segunda pasarela: cobro en pesos a TU cuenta de MP) ---
# El cliente elige PayPal o Mercado Pago en "Pagos y licencia". Mercado Pago
# solo cobra en pesos: el monto sale de convertir MP_PRICE_USD con la
# cotizacion del dia, al momento de generar el link (MP fija el monto de la
# suscripcion al crearla). Sin MP_ACCESS_TOKEN, los endpoints de Mercado Pago
# devuelven 503 y el resto sigue funcionando.
#
# Access Token: https://www.mercadopago.com.ar/developers/panel/app -> tu
# aplicacion -> Credenciales (usa las de PRUEBA mientras probas).
MP_ACCESS_TOKEN=
# "Clave secreta" que muestra el panel al configurar Webhooks (Tus
# integraciones -> tu app -> Webhooks -> Configurar notificaciones, grupo
# "Planes y suscripciones"). Opcional: sirve para validar la firma de los avisos.
MP_WEBHOOK_SECRET=
# 1 = rechazar avisos sin firma (activalo solo si en sandbox viste que vienen firmados).
MP_WEBHOOK_REQUIRE_SIGNATURE=
# URL del webhook (se manda en cada suscripcion y tambien podes cargarla en el panel).
MP_NOTIFICATION_URL=https://tu-servidor/webhooks/mercadopago
# A donde vuelve el navegador del cliente despues de pagar.
MP_BACK_URL=https://www.google.com/?sentinelops_subscribed=1
MP_PRICE_USD=250
# Cotizacion USD->ARS (default: dolar oficial "venta" de dolarapi.com).
# Otros: https://dolarapi.com/v1/dolares/bolsa (MEP), .../tarjeta, .../blue
MP_FX_URL=https://dolarapi.com/v1/dolares/oficial
MP_FX_FIELD=venta
# Recargo opcional sobre la cotizacion, en % (ej. 5 = +5%).
MP_FX_MARGIN_PCT=0
# Cotizacion de emergencia si la API de cotizacion no responde. Sin esto, si
# la API falla no se genera el link (nunca se cobra un monto inventado).
MP_FALLBACK_RATE=
# SOLO pruebas: con credenciales de PRUEBA el pagador tiene que ser un comprador de
# prueba (test_user_<User ID>@testuser.com). En produccion, dejar vacia.
MP_TEST_PAYER_EMAIL=
