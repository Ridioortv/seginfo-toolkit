# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinelops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth service ---
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER_NAME=SentinelOps

# --- Asset / Scan / Vuln services ---
EPSS_API_URL=https://api.first.org/data/v1/epss
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8001
VITE_ASSET_API_BASE_URL=http://localhost:8002
VITE_SCAN_API_BASE_URL=http://localhost:8003
VITE_VULN_API_BASE_URL=http://localhost:8004
VITE_SIEM_API_BASE_URL=http://localhost:8005
VITE_SOAR_API_BASE_URL=http://localhost:8006
VITE_CASE_API_BASE_URL=http://localhost:8007
VITE_PURPLE_API_BASE_URL=http://localhost:8008
VITE_REPORT_API_BASE_URL=http://localhost:8009
VITE_NOTIFICATION_API_BASE_URL=http://localhost:8010
VITE_INTEGRATION_API_BASE_URL=http://localhost:8011

# --- SOAR / Integration / Notification (modo dry-run por defecto) ---
SOAR_DRY_RUN=true
INTEGRATION_DRY_RUN=true
NOTIFICATION_DRY_RUN=true
# --- Google (login/registro) ---
GOOGLE_CLIENT_ID=844503222829-8aog9j673kq33qhq0b1nfoj330lplpoq.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=844503222829-8aog9j673kq33qhq0b1nfoj330lplpoq.apps.googleusercontent.com

# --- Agentes de escaneo remoto que se auto-registran y arrancan solos ---
# scan-service crea estos agentes al arrancar (idempotente); no hace falta
# registrarlos a mano desde la UI. CAMBIA estas keys por valores propios en
# un despliegue real (son secretos: quien tenga la key puede actuar como ese
# agente). 'Agente Docker' corre dentro del stack (internet/host); 'Agente LAN'
# corre en la PC/host (fuera de Docker) para llegar a la red real.
REMOTE_AGENT_DOCKER_KEY=YdhpvgALko_bstsrriW5bsAJekCppiszMsZN7ur6mls
REMOTE_AGENT_LAN_KEY=Ug9kvG8a1sOf1mGWjyb52SToe6uX-njtoW4oiMeApZo
# JSON que consume scan-service (BOOTSTRAP_AGENTS): mismas keys que arriba.
BOOTSTRAP_AGENTS=[{"name": "Agente Docker (internet/host)", "key": "YdhpvgALko_bstsrriW5bsAJekCppiszMsZN7ur6mls"}, {"name": "Agente LAN", "key": "Ug9kvG8a1sOf1mGWjyb52SToe6uX-njtoW4oiMeApZo"}]

SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires
